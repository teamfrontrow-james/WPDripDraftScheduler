{
  "name": "teamfrontrow-james/draft-drip-scheduler",
  "description": "A WordPress plugin for bulk scheduling draft posts to publish sequentially.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.2"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "support": {
    "issues": "https://github.com/teamfrontrow-james/WPDripDraftScheduler/issues",
    "source": "https://github.com/teamfrontrow-james/WPDripDraftScheduler"
  }
}
